<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:hwads="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_above="@id/adView"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="fill_parent"
            android:layout_height="56dp"
            android:layout_weight="0">

            <com.bumbumapps.bouncy.ScoreView
                android:id="@+id/scoreView"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:focusable="false"
                android:onClick="scoreViewClicked" />

            <!-- layout_gravity needs to be set for older Android versions:
            https://stackoverflow.com/questions/24842244/margins-inside-framelayout-is-not-working-in-android-2-2
            -->
            <ImageView
                android:id="@+id/pauseIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_gravity="top"
                android:src="@drawable/ic_baseline_pause_circle_outline_24"
                android:tint="@color/arcade_cyan"
                android:visibility="gone" />

        </FrameLayout>


        <FrameLayout
            android:layout_width="fill_parent"
            android:layout_height="0px"
            android:layout_weight="9">

            <com.bumbumapps.bouncy.CanvasFieldView
                android:id="@+id/canvasFieldView"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:defaultFocusHighlightEnabled="false"
                android:visibility="gone" />

            <com.bumbumapps.bouncy.GLFieldView
                android:id="@+id/glFieldView"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:defaultFocusHighlightEnabled="false"
                android:visibility="gone" />

            <ScrollView
                android:id="@+id/menuScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fillViewport="false"
                android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/buttonPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_arcade_panel"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/menuTitle"
                    style="@style/ArcadeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/arcade_logo" />

                <!-- Shown after a game: score of the last game, "new best" badge, share. -->
                <LinearLayout
                    android:id="@+id/gameOverCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_arcade_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/gameOverLabel"
                        style="@style/ArcadeCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/arcade_game_over" />

                    <TextView
                        android:id="@+id/lastScoreText"
                        style="@style/ArcadeScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="125,400"
                        xmlns:tools="http://schemas.android.com/tools" />

                    <TextView
                        android:id="@+id/newBestBadge"
                        style="@style/ArcadeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/arcade_new_best"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/shareScoreButton"
                        style="@style/ArcadeButton.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:drawableStart="@drawable/ic_arcade_share"
                        android:drawablePadding="8dp"
                        android:minWidth="0dp"
                        android:onClick="doShareScore"
                        android:paddingStart="16dp"
                        android:paddingEnd="18dp"
                        android:text="@string/arcade_share_score"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/selectTableRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_arcade_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <ImageButton
                        android:id="@+id/previousTableButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_arcade_icon_button"
                        android:contentDescription="@string/arcade_previous_table"
                        android:focusableInTouchMode="true"
                        android:onClick="doPreviousTable"
                        android:src="@drawable/ic_arcade_chevron_left" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tableIndexText"
                            style="@style/ArcadeCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="TABLE 1 / 7"
                            xmlns:tools="http://schemas.android.com/tools" />

                        <TextView
                            android:id="@+id/tableNameText"
                            style="@style/ArcadeTableName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Classic"
                            xmlns:tools="http://schemas.android.com/tools" />

                        <TextView
                            android:id="@+id/tableBestText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:drawableStart="@drawable/ic_arcade_trophy"
                            android:drawablePadding="4dp"
                            android:gravity="center_vertical"
                            android:textColor="@color/arcade_gold"
                            android:textSize="13sp"
                            tools:text="Best 48,250"
                            xmlns:tools="http://schemas.android.com/tools" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/nextTableButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_arcade_icon_button"
                        android:contentDescription="@string/arcade_next_table"
                        android:focusableInTouchMode="true"
                        android:onClick="doNextTable"
                        android:src="@drawable/ic_arcade_chevron_right" />
                </LinearLayout>

                <Switch
                    android:id="@+id/unlimitedBallsToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:focusableInTouchMode="true"
                    android:paddingStart="6dp"
                    android:paddingEnd="2dp"
                    android:text="@string/arcade_practice_mode"
                    android:textColor="@color/arcade_text_secondary"
                    android:textSize="14sp"
                    android:thumbTint="@color/arcade_switch_thumb"
                    android:trackTint="@color/arcade_switch_track" />

                <Button
                    android:id="@+id/startGameButton"
                    style="@style/ArcadeButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="14dp"
                    android:drawableStart="@drawable/ic_arcade_play"
                    android:focusableInTouchMode="true"
                    android:onClick="doStartGame"
                    android:paddingStart="24dp"
                    android:paddingEnd="48dp"
                    android:text="@string/arcade_play" />

                <Button
                    android:id="@+id/resumeGameButton"
                    style="@style/ArcadeButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="18dp"
                    android:drawableStart="@drawable/ic_arcade_play"
                    android:focusableInTouchMode="true"
                    android:onClick="doStartGame"
                    android:paddingStart="24dp"
                    android:paddingEnd="48dp"
                    android:text="@string/resume_game_button_label"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/endGameButton"
                    style="@style/ArcadeButton.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:focusableInTouchMode="true"
                    android:onClick="doEndGame"
                    android:text="@string/end_game_button_label"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/highScoreButton"
                        style="@style/ArcadeIconButton"
                        android:contentDescription="@string/show_high_score_button_label"
                        android:onClick="showHighScore"
                        android:src="@drawable/ic_arcade_trophy" />

                    <ImageButton
                        android:id="@+id/rulesButton"
                        style="@style/ArcadeIconButton"
                        android:contentDescription="@string/arcade_table_rules"
                        android:onClick="doAbout"
                        android:src="@drawable/ic_arcade_info" />

                    <ImageButton
                        android:id="@+id/preferencesButton"
                        style="@style/ArcadeIconButton"
                        android:contentDescription="@string/preferences_button_label"
                        android:onClick="doPreferences"
                        android:src="@drawable/ic_arcade_settings" />

                    <ImageButton
                        android:id="@+id/quitButton"
                        style="@style/ArcadeIconButton"
                        android:contentDescription="@string/quit_button_label"
                        android:onClick="doQuit"
                        android:src="@drawable/ic_arcade_exit" />
                </LinearLayout>
            </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/highScorePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/bg_arcade_panel"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="22dp"
                android:paddingBottom="20dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arcade_trophy" />

                <TextView
                    style="@style/ArcadeTableName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/high_score_table_title" />

                <TextView
                    android:id="@+id/highScoreTableName"
                    style="@style/ArcadeCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    tools:text="CLASSIC"
                    xmlns:tools="http://schemas.android.com/tools" />

                <LinearLayout
                    android:id="@+id/highScoreListLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/noHighScoresTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp"
                    android:text="@string/no_high_scores_message"
                    android:textColor="@color/arcade_text_secondary"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/hideHighScoreButton"
                    style="@style/ArcadeButton.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:focusableInTouchMode="true"
                    android:onClick="hideHighScore"
                    android:text="@string/hide_high_score_button_label" />
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>
    <FrameLayout
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
