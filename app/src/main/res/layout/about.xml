<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arcade_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <ImageButton
            android:id="@+id/aboutBackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_arcade_icon_button"
            android:contentDescription="@string/arcade_back"
            android:src="@drawable/ic_arcade_chevron_left" />

        <TextView
            android:id="@+id/aboutTableIndex"
            style="@style/ArcadeCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            tools:text="TABLE 1 / 7" />

        <TextView
            android:id="@+id/aboutTableName"
            style="@style/ArcadeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            tools:text="Classic" />

        <TextView
            style="@style/ArcadeTableName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="@string/arcade_how_to_play"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_arcade_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/ArcadeStep" android:text="@string/arcade_howto_launch" android:drawableStart="@drawable/ic_arcade_play" />
            <TextView style="@style/ArcadeStep" android:text="@string/arcade_howto_flippers" android:drawableStart="@drawable/ic_arcade_flipper" />
            <TextView style="@style/ArcadeStep" android:text="@string/arcade_howto_pause" android:drawableStart="@drawable/ic_arcade_pause" android:layout_marginBottom="0dp" />
        </LinearLayout>

        <TextView
            style="@style/ArcadeTableName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="@string/arcade_table_rules"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/aboutRulesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_arcade_card"
            android:orientation="vertical"
            android:padding="16dp" />

        <TextView
            android:id="@+id/aboutCredits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/arcade_credits"
            android:textColor="#80B3B8C7"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
