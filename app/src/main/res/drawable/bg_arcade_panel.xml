<?xml version="1.0" encoding="utf-8"?>
<!-- Dark glass panel with a neon gradient rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="45" android:startColor="@color/arcade_pink"
                android:centerColor="@color/arcade_violet" android:endColor="@color/arcade_cyan" />
        </shape>
    </item>
    <item android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp" android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="27dp" />
            <solid android:color="@color/arcade_panel" />
        </shape>
    </item>
</layer-list>
