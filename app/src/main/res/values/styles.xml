<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VPTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:colorAccent" tools:targetApi="lollipop">#FFC107</item>
    </style>

    <style name="PreferencesTheme" parent="Theme.VPTheme">
        <item name="android:textColor">@color/arcade_text</item>
        <item name="android:colorAccent" tools:targetApi="lollipop">@color/arcade_cyan</item>
        <item name="android:background">@color/arcade_bg</item>
        <item name="android:textColorSecondary">@color/arcade_text_secondary</item>
    </style>

    <!-- Neon arcade menu -->
    <style name="ArcadeTitle">
        <item name="android:fontFamily">@font/jakarta_extrabold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/arcade_text</item>
    </style>

    <style name="ArcadeTableName">
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/arcade_text</item>
    </style>

    <style name="ArcadeScore">
        <item name="android:fontFamily">@font/jakarta_extrabold</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/arcade_gold</item>
    </style>

    <style name="ArcadeCaption">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="android:textColor">@color/arcade_text_secondary</item>
    </style>

    <style name="ArcadeBadge">
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/arcade_bg</item>
        <item name="android:background">@drawable/bg_arcade_badge</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="ArcadeButton">
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/arcade_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="ArcadeButton.Primary">
        <item name="android:background">@drawable/bg_arcade_button_primary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="ArcadeButton.Secondary">
        <item name="android:background">@drawable/bg_arcade_button_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ArcadeStep">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/arcade_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="ArcadeIconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_arcade_icon_button</item>
        <item name="android:padding">13dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>
</resources>